{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ding-ziwei",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 24,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "account_id": "25dd8528a2015528a14216f0643da541",
  "routes": [
    {
      "pattern": "suanming.alixjd.com",
      "custom_domain": true
    }
  ]
}
